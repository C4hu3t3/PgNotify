<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Meta-package for the "write side" of a PostgreSQL notifications setup: pulls in PgNotify.EFCore, PgNotify.Migrations, and PgNotify.Analyzers so the project that owns the DbContext and configures notifications only needs one package reference. Contains no code of its own.</Description>
    <PackageId>PgNotify.Writer</PackageId>
  </PropertyGroup>

  <!-- Plain ProjectReferences (no OutputItemType="Analyzer"/ReferenceOutputAssembly="false"):
       those flags tell the local build to skip using the referenced assembly, but `dotnet pack`
       reads them the same way and converts each into a nuspec <dependency>, which is what lets a
       consumer installing only this package transitively pull in each project's own packed
       layout. No direct reference to PgNotify.Analyzers here: PgNotify.EFCore's own
       PrivateAssets="none" reference to it (see PgNotify.EFCore.csproj) already makes Analyzers
       flow transitively into anyone who depends on EFCore - which every consumer of this
       meta-package does - so a second, redundant direct dependency here would just be another
       place to keep in sync. -->
  <ItemGroup>
    <ProjectReference Include="..\PgNotify.EFCore\PgNotify.EFCore.csproj" />
    <ProjectReference Include="..\PgNotify.Migrations\PgNotify.Migrations.csproj" />
  </ItemGroup>

</Project>
