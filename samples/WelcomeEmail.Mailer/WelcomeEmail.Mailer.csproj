<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Overrides Directory.Build.props' solution-wide RootNamespace (meant for the library
         projects), same as every other sample project. -->
    <RootNamespace>WelcomeEmail.Mailer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- WelcomeEmail.Model, for the Member POCO the handler is keyed on - but no EF Core and no
         Npgsql.EntityFrameworkCore.PostgreSQL, exactly like TaskBoard.Watcher. The projected
         payload means this process never needs to open the database: PgNotify.Runtime alone is
         enough. Contrast Orders.Projector, which references PgNotify.Listener and keeps its own
         DbContext precisely because its minimal payload forces a re-read. -->
    <ProjectReference Include="..\WelcomeEmail.Model\WelcomeEmail.Model.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.Runtime\PgNotify.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
