<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Overrides Directory.Build.props' solution-wide RootNamespace (meant for the library
         projects) so `dotnet ef migrations add` derives a sensible Migrations/ namespace. -->
    <RootNamespace>CacheInvalidation.WebApi</RootNamespace>
    <UserSecretsId>a3c1e7f0-3f0a-4a1b-9b8b-2e6f2d6c9a11</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PgNotify.Core\PgNotify.Core.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.EFCore\PgNotify.EFCore.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.Migrations\PgNotify.Migrations.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.Runtime\PgNotify.Runtime.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.Runtime.EFCore\PgNotify.Runtime.EFCore.csproj" />
  </ItemGroup>

</Project>
