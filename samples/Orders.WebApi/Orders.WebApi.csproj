<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Overrides Directory.Build.props' solution-wide RootNamespace (meant for the library
         projects) so `dotnet ef migrations add` derives a sensible Migrations/ namespace. -->
    <RootNamespace>Orders.WebApi</RootNamespace>
    <UserSecretsId>7d3e9a5c-1b6f-4e2a-9c4d-6a8b3f1e0d27</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- One reference, not five: PgNotify.Writer bundles EFCore + Migrations + Analyzers (and
         EFCore itself pulls in Core), which is exactly what a project that owns the DbContext and
         configures notifications needs and nothing a listener-only process would. Contrast with
         CacheInvalidation.WebApi, which references all five library projects individually. -->
    <ProjectReference Include="..\Orders.Model\Orders.Model.csproj" />
    <ProjectReference Include="..\..\src\PgNotify.Writer\PgNotify.Writer.csproj" />
  </ItemGroup>

</Project>
