<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PgNotify</RootNamespace>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>PgNotify contributors</Authors>
    <Product>PgNotify</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/C4hu3t3/PgNotify</RepositoryUrl>
    <PackageProjectUrl>https://github.com/C4hu3t3/PgNotify</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- src/ projects are packable library projects; tests and samples opt back out below. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>efcore;entity-framework-core;postgresql;postgres;npgsql;listen-notify;notifications;realtime;pubsub;cache-invalidation</PackageTags>
  </PropertyGroup>

  <!-- Published packages must work on both the current LTS runtime and the next preview: every
       packable src/ library multi-targets net10.0 and net11.0. PgNotify.Analyzers is the one
       exception - it keeps its own netstandard2.0 override in its .csproj, since a Roslyn
       analyzer always runs hosted on netstandard2.0 regardless of the consuming project's
       TargetFramework. Test projects multi-target the same two TFMs too, so `dotnet test`
       actually exercises both runtimes instead of just compiling against them; samples and
       benchmarks stay on the single default TargetFramework above since they exist to demonstrate
       usage, not to prove compatibility. TargetFramework must be cleared before TargetFrameworks
       is set - the SDK rejects a project with both non-empty (NETSDK1013). -->
  <PropertyGroup Condition="($(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)')) AND '$(MSBuildProjectName)' != 'PgNotify.Analyzers') OR $(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)tests$([System.IO.Path]::DirectorySeparatorChar)'))">
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Every packable project embeds the repo's root README as its NuGet readme — same source
       everyone landing on the package page from the repo already reads, not a per-package
       duplicate to keep in sync. $(MSBuildThisFileDirectory) is this props file's own directory
       (the repo root) regardless of which project imports it. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- CS1591 (missing XML doc on a public member) only matters for a packable library's public API
       surface; suppress it outside src/ so xUnit's public test classes/methods, sample Program.cs
       top-level types, and benchmark classes don't generate warning noise. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
